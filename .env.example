# Copia este archivo como referencia de qué variables configurar en Vercel
# (Project Settings -> Environment Variables). NUNCA subas un archivo .env real a git.
# Para probar en local con "vercel dev", puedes copiar esto a un archivo ".env" (ya está en .gitignore).

# Llave pública de Wompi (Dashboard Wompi -> Configuración -> Llaves API)
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Llave/secreto de integridad de Wompi (misma sección del dashboard). SECRETA.
WOMPI_INTEGRITY_SECRET=prod_integrity_xxxxxxxxxxxxxxxxxxxxxxxx

# Secreto de eventos/webhook de Wompi (Dashboard Wompi -> Configuración -> Eventos). SECRETA.
# Solo hace falta cuando configures el webhook en /api/webhooks/wompi.
WOMPI_EVENTS_SECRET=events_xxxxxxxxxxxxxxxxxxxxxxxx

# Contraseña única para entrar al backoffice (/admin). Elige una contraseña fuerte.
ADMIN_PASSWORD=cambia-esto-por-una-contraseña-fuerte

# Secreto usado para firmar la cookie de sesión del backoffice. Cualquier cadena
# larga y aleatoria sirve (ej. genera una con: openssl rand -hex 32).
ADMIN_SESSION_SECRET=cambia-esto-por-una-cadena-aleatoria-larga

# Esta la crea Vercel automáticamente al conectar una base de datos Postgres
# (Storage -> Create Database -> Postgres -> Connect Project). No la escribas a mano.
# POSTGRES_URL=postgres://...
