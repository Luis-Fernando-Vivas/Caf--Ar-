# Copia este archivo como referencia de qué variables configurar en Vercel
# (Project Settings -> Environment Variables). NUNCA subas un archivo .env real a git.
# Para probar en local con "vercel dev", puedes copiar esto a un archivo ".env" (ya está en .gitignore).

# Café Arú soporta dos entornos de Wompi a la vez (sandbox y producción) y el
# switch para pasar de uno a otro se hace desde el backoffice (/admin), sin
# redesplegar. Por eso hay un juego de llaves _TEST y otro _PROD.

# --- Entorno de PRUEBA (sandbox) ---
# Dashboard Wompi -> arriba a la derecha, modo "Sandbox" -> Configuración -> Llaves API
WOMPI_PUBLIC_KEY_TEST=pub_test_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET_TEST=prod_integrity_xxxxxxxxxxxxxxxxxxxxxxxx
# Configuración -> Eventos (modo Sandbox). Solo hace falta si vas a probar el
# webhook /api/webhooks/wompi en local (necesitas una URL pública, ej. ngrok).
WOMPI_EVENTS_SECRET_TEST=events_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Entorno de PRODUCCIÓN (cobra dinero real) ---
# Dashboard Wompi -> modo "Producción" -> Configuración -> Llaves API
WOMPI_PUBLIC_KEY_PROD=pub_prod_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET_PROD=prv_prod_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_EVENTS_SECRET_PROD=prod_events_xxxxxxxxxxxxxxxxxxxxxxxx

# Contraseña única para entrar al backoffice (/admin). Elige una contraseña fuerte.
ADMIN_PASSWORD=cambia-esto-por-una-contraseña-fuerte

# Secreto usado para firmar la cookie de sesión del backoffice. Cualquier cadena
# larga y aleatoria sirve (ej. genera una con: openssl rand -hex 32).
ADMIN_SESSION_SECRET=cambia-esto-por-una-cadena-aleatoria-larga

# Esta la crea Vercel automáticamente al conectar una base de datos Postgres
# (Storage -> Create Database -> Postgres -> Connect Project). No la escribas a mano.
# También se usa para guardar cuál entorno de Wompi está activo (tabla "settings"),
# así que sin ella el switch de /admin siempre vuelve a "Prueba" por defecto.
# POSTGRES_URL=postgres://...

# Subida de fotos de productos desde el admin (Dashboard Cloudinary -> Settings -> API Keys).
# Sin estas tres, el botón "Subir foto" del backoffice muestra un aviso pero no rompe nada más.
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret
